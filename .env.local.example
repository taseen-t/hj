# ---------------------------------------------------------------------------
# Copy this file to ".env.local" and fill in values.
#
# LOCAL MODE (default): leave the SUPABASE_* vars blank. Submissions are saved
# to ./.data/applications.json and photos are stored inline. No setup needed.
#
# SUPABASE MODE: fill SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (and create the
# table + storage bucket from supabase/schema.sql). The app switches over
# automatically once both values are present.
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=application-photos

# Passcode used to open the /admin panel. REQUIRED — there is no default.
# If this is unset the admin panel refuses all logins (it fails closed rather
# than falling back to a known password). Use a long, random value.
ADMIN_PASSCODE=
